{
  "name": "JR Roofing Private Owner Preview",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "JR Roofing private owner preview",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "PORT": "3000"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  }
}
